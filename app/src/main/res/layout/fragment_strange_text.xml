<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View
        android:id="@+id/viewForTransform"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="40dp"
        app:layout_constraintDimensionRatio="750:200"
        app:layout_constraintWidth_percent="0.7"
        android:background="@drawable/round_dash_bg_trans"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/viewTransformed"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <EditText
        android:id="@+id/textForTransform"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:backgroundTint="@color/grey"
        android:hint="@string/enter_text"
        android:textColor="@color/white"
        android:textColorHint="@color/grey"
        android:fontFamily="sans-serif"
        android:gravity="center"

        app:layout_constraintTop_toTopOf="@id/viewForTransform"
        app:layout_constraintBottom_toBottomOf="@id/viewForTransform"
        app:layout_constraintStart_toStartOf="@id/viewForTransform"
        app:layout_constraintEnd_toEndOf="@id/viewForTransform" />

    <View
        android:id="@+id/viewTransformed"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="750:600"
        app:layout_constraintWidth_percent="0.7"
        android:layout_marginBottom="40dp"
        android:background="@drawable/round_dash_bg_trans"
        app:layout_constraintTop_toBottomOf="@id/viewForTransform"
        app:layout_constraintBottom_toTopOf="@id/buttonTransform"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>

    <TextView
        android:id="@+id/textTransformed"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:scrollbars="vertical"
        android:text="@string/transformed_text"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="@id/viewTransformed"
        app:layout_constraintBottom_toBottomOf="@id/viewTransformed"
        app:layout_constraintStart_toStartOf="@id/viewTransformed"
        app:layout_constraintEnd_toEndOf="@id/viewTransformed" />

    <Button
        android:id="@+id/buttonTransform"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/round_dash_bg"
        app:layout_constraintDimensionRatio="750:200"
        app:layout_constraintWidth_percent="0.7"
        app:backgroundTint="@null"
        android:text="@string/transform"
        android:textColor="@android:color/white"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/viewTransformed"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <com.exjunk.lib.thanos.vanish.VanishGLSurfaceView
        android:id="@+id/glSurfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</androidx.constraintlayout.widget.ConstraintLayout>