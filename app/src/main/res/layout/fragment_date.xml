<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/anchorPhoto"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="40dp"
        android:visibility="invisible"
        app:layout_constraintDimensionRatio="750:750"
        app:layout_constraintWidth_percent="0.7"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/imageDate"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <View
        android:id="@+id/imageDate"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="40dp"
        android:scaleType="fitCenter"
        app:layout_constraintDimensionRatio="750:200"
        app:layout_constraintWidth_percent="0.7"
        android:background="@drawable/round_dash_bg_trans"
        app:layout_constraintTop_toBottomOf="@+id/anchorPhoto"
        app:layout_constraintBottom_toTopOf="@+id/buttonDate"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>

    <ImageButton
        android:id="@+id/buttonDate"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/round_dash_bg"
        android:scaleType="fitCenter"
        app:layout_constraintDimensionRatio="750:200"
        app:layout_constraintWidth_percent="0.7"
        app:srcCompat="@drawable/button"
        app:layout_constraintTop_toBottomOf="@+id/imageDate"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/containerContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imagePhoto"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="40dp"
            app:layout_constraintDimensionRatio="1:1"
            android:scaleType="centerCrop"
            app:layout_constraintWidth_percent="0.7"
            app:srcCompat="@drawable/add_image"
            android:background="@drawable/round_dash_bg"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/anchorText"
            app:layout_constraintVertical_chainStyle="packed"/>

        <View
            android:id="@+id/anchorText"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="40dp"
            app:layout_constraintDimensionRatio="750:200"
            app:layout_constraintWidth_percent="0.7"
            app:layout_constraintTop_toBottomOf="@id/imagePhoto"
            app:layout_constraintBottom_toTopOf="@+id/anchorButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <View
            android:id="@+id/anchorButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            app:layout_constraintDimensionRatio="750:200"
            app:layout_constraintWidth_percent="0.7"
            app:layout_constraintTop_toBottomOf="@+id/anchorText"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>

        <TextView
            android:id="@+id/textDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/date_for_read"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:fontFamily="sans-serif"
            app:layout_constraintBottom_toBottomOf="@+id/anchorText"
            app:layout_constraintEnd_toEndOf="@+id/anchorText"
            app:layout_constraintStart_toStartOf="@+id/anchorText"
            app:layout_constraintTop_toTopOf="@+id/anchorText" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.exjunk.lib.thanos.vanish.VanishGLSurfaceView
        android:id="@+id/glSurfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</androidx.constraintlayout.widget.ConstraintLayout>